{
  "name": "doctoriq-clinic-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Privacy-safe clinic appointment demo with simulated doctors, slots, and queue status.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler pages dev . --port 8788",
    "test": "node --test tests/*.test.js",
    "deploy": "wrangler pages deploy . --project-name doctoriq --branch main",
    "db:seed": "wrangler d1 execute omegaapi-demos --remote --file=migrations/0001_init.sql"
  },
  "devDependencies": {
    "wrangler": "4.166.0"
  }
}
